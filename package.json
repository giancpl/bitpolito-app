{
  "name": "bitpolito-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "VITE_HUB_PREVIEW=true vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && esbuild src/service-worker.ts --bundle --format=iife --target=es2022 --outfile=dist/client/sw.js && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js && esbuild scripts/backup.ts scripts/admin.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/scripts",
    "start": "NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "npm run build && playwright test -c playwright.pwa.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/backup.ts --restore",
    "db:generate": "drizzle-kit generate",
    "admin:grant": "tsx scripts/admin.ts",
    "push:keys": "tsx scripts/push-keys.ts",
    "dev:sandbox": "VITE_HUB_PREVIEW=true vite --host 127.0.0.1",
    "test:sandbox": "playwright test -c playwright.hub.config.ts",
    "android:setup": "bash scripts/android-toolchain.sh",
    "android:build": "bash scripts/android-build.sh",
    "android:install": ".android-local/sdk/platform-tools/adb install -r artifacts/bitpolito-sandbox.apk",
    "dev:android-sandbox": "concurrently -k -n relay-eu,relay-us \"tsx scripts/local-relay.ts 3480\" \"tsx scripts/local-relay.ts 3481\"",
    "dev:legacy": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:relays": "concurrently -k -n relay-eu,relay-us \"tsx scripts/local-relay.ts 3480\" \"tsx scripts/local-relay.ts 3481\"",
    "resources:export": "tsx scripts/export-resources.ts",
    "marmot:setup": "python3 scripts/marmot-setup.py",
    "build:preview": "VITE_HUB_PREVIEW=true npm run build",
    "dev:android-sandbox:legacy": "tsx scripts/android-sandbox.ts",
    "dev:sandbox:legacy": "tsx scripts/sandbox.ts",
    "test:legacy:sandbox": "playwright test -c playwright.sandbox.config.ts",
    "test:android:hub": "node scripts/android-hub-smoke.mjs",
    "test:android:protocol": "bash scripts/android-protocol-test.sh",
    "test:android:recovery": "node scripts/android-hub-recovery.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.7",
    "@scure/base": "^2.4.0",
    "@tanstack/react-query": "^5.90.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "firebase-admin": "^14.5.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.468.0",
    "motion": "14.14.0",
    "nostr-tools": "^2.26.0",
    "qrcode": "^1.5.4",
    "radix-ui": "1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "web-push": "^4.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5",
    "ws": "^8.22.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.11"
    }
  }
}
