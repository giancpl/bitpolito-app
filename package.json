{
  "name": "bitpolito-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "VITE_HUB_PREVIEW=true vite --host 127.0.0.1",
    "dev:relays": "concurrently -k -n relay-eu,relay-us \"tsx scripts/local-relay.ts 3480\" \"tsx scripts/local-relay.ts 3481\"",
    "build": "tsc --noEmit && vite build",
    "build:preview": "VITE_HUB_PREVIEW=true npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "android:setup": "bash scripts/android-toolchain.sh",
    "android:build": "bash scripts/android-build.sh",
    "android:install": ".android-local/sdk/platform-tools/adb install -r artifacts/bitpolito-sandbox.apk",
    "marmot:setup": "python3 scripts/marmot-setup.py",
    "test:android:hub": "node scripts/android-hub-smoke.mjs",
    "test:android:protocol": "bash scripts/android-protocol-test.sh",
    "test:android:recovery": "node scripts/android-hub-recovery.mjs",
    "resources:export": "tsx scripts/export-resources.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@scure/base": "^2.4.0",
    "@tanstack/react-query": "^5.90.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.468.0",
    "motion": "14.14.0",
    "nostr-tools": "^2.26.0",
    "qrcode": "^1.5.4",
    "radix-ui": "1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.1.12",
    "vitest": "^5.0.5",
    "ws": "^8.22.2"
  },
  "description": "BitPolito Hub: an Android-first encrypted team app built on Nostr and Marmot."
}
