# Archived server/PWA installation only. The distributed Android APK does not use this backend configuration.
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
DATA_DIR=./data
COOKIE_SECURE=false
# NIP-46 signer traffic only. Presence and requests stay in the private database.
# Public Primal signer relay by default; comma-separated overrides are supported.
# Set RELAY_URLS= explicitly to disable remote/mobile signer relays.
RELAY_URLS=wss://nrs.primal.net
# Optional locally. Generate once with npm run push:keys; preserve private key securely.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional Android FCM; separate from Web Push. Protect the service-account file.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
